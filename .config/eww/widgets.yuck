;=====Arch_Linux_Logo============================
(defvar arch_logo "")

(defwidget Arch_logo []
  (box  :orientation "h"
        :spacing 0
        (label  :class "arch_linux_logo"
                :text arch_logo)
  )
)


;=====Workspace==================================
(defvar ws-dot "")

(defpoll workspace_data :interval "0.5s"
  :initial `{"current": 1, "workspaces": [1]}`
  `~/.config/eww/scripts/workspaces.sh`)

(defwidget ws-btn [id]
  (button
    :class {"${workspace_data.current}" == "${id}" ? "ws-active" : "ws-inactive"}
    :onclick `hyprctl dispatch workspace ${id}`
    (label :text {"${workspace_data.current}" == "${id}" ? ws-dot : "${id}"})
  )
)

(defwidget workspace []
  (box :class "workspace-container"
       :orientation "h"
       :spacing 2
       (for ws in {workspace_data.workspaces}
          (ws-btn :id "${ws}")
       )
  )
)






;=====CPU_And_Memory_Usages==================
;; CPU and Memory usage widget with circular progress

;; Define icons 
(defvar icon-cpu "")
(defvar icon-mem "")

;; Circular progress widget component
(defwidget circular_progress [value label color]
  (box :class "circular-progress-container"
       :orientation "v"
       :space-evenly false
       :spacing 4
    (box :class "circular-progress"
         :style "background: conic-gradient({color} {value}%, #1e3440 0%);")
    (label :text label  ;; Just use label directly, no quotes
           :class "progress-label")
  )
)

;; Poll for system information
(defpoll cpu_mem_data :interval "2s" "~/.config/eww/scripts/cpu_mem.sh")

;; Main CPU and Disk widget
(defwidget cpu_mem []
  (box :class "cpu-mem-container"
       :orientation "h"
       :space-evenly true
       :spacing 0
    ;; CPU section
    (box :class "cpu-mem-item"
         :orientation "h"
         :spacing 0
      (label :text icon-cpu
             :class "cpu-mem-icon")
      (circular_progress :value {cpu_mem_data.cpu}
                        :label "${cpu_mem_data.cpu}%"
                        :color "#60afef")
    )
    
    ;; Memory section 
    (box :class "cpu-mem-item"
         :orientation "h"
         :spacing 0
      (label :text icon-mem
             :class "cpu-mem-icon")
      (circular_progress :value {cpu_mem_data.memory}
                        :label "${cpu_mem_data.memory}%"
                        :color "#97c379")
    )
  )
)



;=====Wifi=======================================
(defpoll wifi-data :interval "1s" "~/.config/eww/scripts/wifi.sh")

(defwidget wifi []
  (button 
    :onclick "~/.config/eww/scripts/wifi.sh toggle"
    :tooltip "${wifi-data.ssid}"
    "${wifi-data.icon}"
  )
)



;=====Battery====================================
(defpoll battery-data :interval "5s" "~/.config/eww/scripts/battery.sh")  

(defwidget battery []
  (box :class "battery_container" :orientation "h" :tooltip "${battery-data.class}"
    (label :class "${battery-data.class} battery-icon" :text "${battery-data.icon}")
    (label :class "${battery-data.class}" :text "${battery-data.level}%")
  )
)

;=====Low_Battery_Warning==========================
(defwidget low_batt_warning []
  (box :class "low-batt-container"
       :orientation "v"
       :spacing 12
    (label :class "low-batt-icon" :text "")
    (label :class "low-batt-msg" :text "Battery is low!")
    (label :class "low-batt-sub" :text "Please connect to charger")
    (button :class "low-batt-btn"
            :onclick "eww close low_batt_warning"
            "OK"
    )
  )
)



;=====Time=======================================
(defpoll time_poll :interval "10s" "date '+%a %d-%b  %H:%M'")

(defwidget time[]
  (box :class "time_container" :orientation "h" (label :class "time" :text time_poll))
)
