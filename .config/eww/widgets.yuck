;=====Arch_Linux_Logo============================
(defvar arch_logo "")

(defwidget Arch_logo []
  (box  :orientation "h"
        :spacing 0

      (label  :text arch_logo :class "arch_linux_logo")
  )
)


;=====Workspace==================================
(defvar ws-dot "")

(defpoll workspace_data :interval "0.5s"
  :initial `{"current": 1, "workspaces": [1]}` `~/.config/eww/scripts/workspaces.sh`)

(defwidget ws-btn [id]
  (button :class {"${workspace_data.current}" == "${id}" ? "ws-active" : "ws-inactive"}
          :onclick `hyprctl dispatch workspace ${id}`
      (label :text {"${workspace_data.current}" == "${id}" ? ws-dot : "${id}"})
  )
)

(defwidget workspace []
  (box :class "workspace-container"
       :orientation "h"
       :spacing 2

      (for ws in {workspace_data.workspaces}
        (ws-btn :id "${ws}")
      )
  )
)






;=====System_Stats===============================
;cpu_usage ,mem_usage ,temp

(defvar icon-cpu "")
(defvar icon-mem "")

(defpoll System_data :interval "2s" "~/.config/eww/scripts/system_stats.sh")

(defwidget system_stats []
  (box  :class "system-stats-container"
        :orientation "h"
        :space-evenly false
        :spacing 8

      (box  :class "cpu-container" 
            :orientation "h" 
            :space-evenly false
            :spacing 8

          (label  :text icon-cpu              :class "cpu-icon")
          (label  :text "${System_data.cpu}%" :class "cpu-label")
      )

      (box  :class "memory-container" 
            :orientation "h" 
            :space-evenly false
            :spacing 8

          (label  :text icon-mem                  :class "mem-icon")
          (label  :text "${System_data.memory}%"  :class "mem-label")
      )

      (box  :class "memory-container" 
            :orientation "h" 
            :space-evenly false
            :spacing 5

          (label  :text "${System_data.temp_icon}"  :class "${System_data.temp_state}")
          (label  :text "${System_data.temp_lvl}°C" :class "${System_data.temp_state}")
      )
  )
)



;=====PKG_Updates_Avalable=======================
(defvar icon-updates "")

(defpoll update_data :interval "3600s" "~/.config/eww/scripts/updates.sh")

(defwidget updates []
  (tooltip

    (box :orientation "v" :spacing 4
      (label :text "pacman: ${update_data.pacman_u}")
      (label :text "yay: ${update_data.yay_u}")
    )

    (box :class "updates-container"
         :orientation "h"
         :spacing 1
      (label :text icon-updates)
      (label :text "${update_data.count}")
    )
  )
)


;=====Wifi=======================================
(defpoll wifi-data :interval "1s" "~/.config/eww/scripts/wifi.sh")

(defwidget wifi []
  (button 
    :onclick "~/.config/eww/scripts/wifi.sh toggle"
    :tooltip "${wifi-data.ssid}"
    "${wifi-data.icon}"
  )
)



;=====Battery====================================
(defpoll battery-data :interval "5s" "~/.config/eww/scripts/battery.sh")  

(defwidget battery []
  (box  :class "battery_container" 
        :orientation "h" 
        :tooltip "${battery-data.class}"

    (label  :text "${battery-data.icon}"   :class "${battery-data.class}")
    (label  :text "${battery-data.level}%" :class "${battery-data.class}")
  )
)

;=====Low_Battery_Warning==========================
(defwidget low_batt_warning []
  (box :class "low-batt-container"
       :orientation "v"
       :spacing 12

    (label  :text "Battery is low!"           :class "low-batt-msg")
    (label  :text "Please connect to charger" :class "low-batt-sub" )

    (button :class "low-batt-btn"
            :onclick "eww close low_batt_warning"
            "OK"
    )
  )
)



;=====Time_Date_Calender=======================================
(defpoll time_poll :interval "10s" "date '+%a %d-%b  %H:%M'")

(defwidget time_date_cal []
  (eventbox
    :onhover "eww open cal_popup"
    :onhoverlost "sleep 0.3 && eww close cal_popup 2>/dev/null"
    (box :class "time_container"
      (label :class "time" :text time_poll)
    )
  )
)
