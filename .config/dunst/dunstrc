[global]
    # Position
    origin = bottom-center
    offset = (0, 30)

    # Size
    width = 320
    height = 70
    notification_limit = 5

    # Appearance
    frame_width = 0
    separator_height = 0
    transparency = 10

    font = Monospace 11
    format = "<b>%s</b>\n%b"

    alignment = center
    vertical_alignment = center

    word_wrap = no
    ignore_newline = yes

    history_length = 20
    sticky_history = yes

    # Progress bar
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 240
    progress_bar_max_width = 280
    
[urgency_low]
    background = "#1e1e1ecc"
    foreground = "#ffffff"
    timeout = 5

[urgency_normal]
    background = "#1e1e1ecc"
    foreground = "#ffffff"
    timeout = 10

[urgency_critical]
    background = "#cc0000"
    foreground = "#ffffff"
    timeout = 0


# ==========================================================
# macOS-style Volume HUD
# ==========================================================

[changevolume]
    appname = "changevolume"

    origin = bottom-center
    offset = 0x80

    width = 320
    height = 70

    frame_width = 0
    separator_height = 0

    corner_radius = 16

    background = "#1c1c1ecc"
    foreground = "#ffffff"

    font = Monospace 11
    alignment = center

    padding = 12
    horizontal_padding = 20
    text_icon_padding = 12

    format = "<b>%s</b>\n%b"

    timeout = 2
    history_ignore = yes

    # Progress bar
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 240
    progress_bar_max_width = 280


